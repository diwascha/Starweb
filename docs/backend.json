
{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a user of the application with RBAC permissions.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "isAdmin": { "type": "boolean" },
        "isApproved": { "type": "boolean" },
        "permissions": { "type": "object" },
        "passwordLastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "username"]
    },
    "PurchaseOrder": {
      "title": "Purchase Order",
      "description": "Procurement document for raw materials.",
      "type": "object",
      "properties": {
        "poNumber": { "type": "string" },
        "poDate": { "type": "string", "format": "date-time" },
        "companyName": { "type": "string" },
        "status": { "type": "string", "enum": ["Draft", "Ordered", "Amended", "Delivered", "Canceled"] },
        "items": { "type": "array" }
      },
      "required": ["poNumber", "poDate", "companyName", "items"]
    },
    "Cheque": {
      "title": "Cheque Voucher",
      "description": "PDC or issued cheque record for payments.",
      "type": "object",
      "properties": {
        "voucherNo": { "type": "string" },
        "payeeName": { "type": "string" },
        "amount": { "type": "number" },
        "splits": { "type": "array" },
        "status": { "type": "string" }
      },
      "required": ["voucherNo", "payeeName", "amount"]
    },
    "Transaction": {
      "title": "Financial Transaction",
      "description": "General ledger entry for income or expense.",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["Purchase", "Sales", "Payment", "Receipt"] },
        "amount": { "type": "number" },
        "billingType": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["date", "type", "amount"]
    },
    "Employee": {
      "title": "Employee Profile",
      "description": "Personnel master record.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "status": { "type": "string" },
        "wageBasis": { "type": "string" },
        "wageAmount": { "type": "number" }
      },
      "required": ["name", "status", "wageBasis", "wageAmount"]
    },
    "GsmReport": {
      "title": "GSM Quality Report",
      "description": "Paper grammage verification record with multiple entries.",
      "type": "object",
      "properties": {
        "voucherNo": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "vendorId": { "type": "string" },
        "vendorName": { "type": "string" },
        "entries": { "type": "array" },
        "avgGsm": { "type": "number" },
        "ownership": { "type": "string" }
      },
      "required": ["voucherNo", "date", "vendorId", "avgGsm", "ownership"]
    },
    "CRMContact": {
      "title": "CRM Contact",
      "description": "An individual person associated with a client company.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "partyId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "designation": { "type": "string" },
        "isPrimary": { "type": "boolean" },
        "customFields": { "type": "object" }
      },
      "required": ["id", "partyId", "name"]
    },
    "InteractionLog": {
      "title": "Interaction Log",
      "description": "Log of communications with a contact or company.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "subject": { "type": "string" },
        "type": { "type": "string", "enum": ["Call", "Email", "Meeting", "Note"] },
        "description": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "contactId": { "type": "string" },
        "partyId": { "type": "string" }
      },
      "required": ["id", "type", "date"]
    },
    "PaymentTrackerEntry": {
      "title": "Payment Tracker Entry",
      "description": "Daily payment tracking record for receipts and outflows.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["Received", "Outflow"] },
        "partyName": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "ownership": { "type": "string" }
      },
      "required": ["id", "date", "type", "partyName", "amount"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/system_users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Master user directory with security flags."
    },
    "/purchaseOrders/{id}": {
      "schema": { "$ref": "#/entities/PurchaseOrder" },
      "description": "Procurement registry."
    },
    "/cheques/{id}": {
      "schema": { "$ref": "#/entities/Cheque" },
      "description": "PDC and voucher registry."
    },
    "/transactions/{id}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Unified financial ledger."
    },
    "/expenses/{id}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Direct operational expense tracking."
    },
    "/employees/{id}": {
      "schema": { "$ref": "#/entities/Employee" },
      "description": "Workforce master data."
    },
    "/gsm_reports/{id}": {
      "schema": { "$ref": "#/entities/GsmReport" },
      "description": "Grammage verification logs."
    },
    "/attendance/{id}": {
      "schema": { "type": "object" },
      "description": "Processed labor metrics."
    },
    "/payroll/{id}": {
      "schema": { "type": "object" },
      "description": "Monthly financial settlements for staff."
    },
    "/settings/{id}": {
      "schema": { "type": "object" },
      "description": "System-wide configuration and branding."
    },
    "/crm_contacts/{id}": {
      "schema": { "$ref": "#/entities/CRMContact" },
      "description": "Individual client contacts."
    },
    "/crm_interactions/{id}": {
      "schema": { "$ref": "#/entities/InteractionLog" },
      "description": "Activity history for CRM entities."
    },
    "/payment_tracker/{id}": {
      "schema": { "$ref": "#/entities/PaymentTrackerEntry" },
      "description": "Daily payment tracking records for receipts and outflows."
    }
  }
}
