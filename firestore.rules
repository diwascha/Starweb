
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Core Security Helpers ---

    function isAuthenticated() {
      return request.auth != null;
    }

    // Absence of the flag means NOT approved. It previously defaulted to true,
    // which combined with an open create rule on system_users let anyone mint
    // themselves an approved account and read/write the whole database.
    function isApproved() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/system_users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/system_users/$(request.auth.uid)).data.get('isApproved', false) == true;
    }

    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/system_users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/system_users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    // --- Semi-Public Configurations ---

    match /settings/companyProfile { allow read: if true; }
    match /settings/fleetCompanyProfile { allow read: if true; }
    match /settings/appBranding { allow read: if true; }
    match /settings/ownership_categories { allow read: if true; }

    match /settings/{settingId} {
      allow read: if isAuthenticated(); 
      allow write: if isAdmin();
    }

    // --- Identity & Access ---

    match /system_users/{userId} {
      // Was a blanket `read`, which let an authenticated-but-unapproved account
      // enumerate every staff username, email and role flag. Reading your own
      // record is needed at sign-in; listing everyone is an admin screen.
      // (No password material lives here - Firebase Auth holds credentials and
      // this document only carries passwordLastUpdated.)
      allow get: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin(); 

      // Was `allow create: if true` - unauthenticated, any uid, any payload.
      //
      // Accounts in this app are PROVISIONED BY AN ADMIN (Settings > System);
      // there is no self-signup page. So an admin must be able to write a
      // profile for a uid that is not their own - the first version of this
      // rule allowed only self-creation and silently broke user creation
      // entirely: the Firebase Auth account was made, the profile write was
      // denied, and the new user could never sign in.
      //
      // The self-creation branch stays for a future signup page, and for the
      // fact that anyone can mint an Auth account directly against the public
      // API key: such a profile is forced unapproved and non-admin, which
      // grants nothing until an admin approves it.
      allow create: if isAdmin() ||
                       (isAuthenticated() && 
                        request.auth.uid == userId &&
                        request.resource.data.get('isApproved', false) == false &&
                        request.resource.data.get('isAdmin', false) == false);

      allow update: if (isAdmin() && request.auth.uid != userId) || 
                       (isAuthenticated() && request.auth.uid == userId && 
                        request.resource.data.get('isApproved', false) == resource.data.get('isApproved', false) &&
                        request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false));
                        
      allow delete: if isAdmin() && userId != request.auth.uid && 
                       resource.data.get('isAdmin', false) != true;
    }

    match /sessions/{sessionId} {
      // Only `update` used to check ownership. `read` and `delete` were open to
      // any authenticated account, so anyone signed in - including one still
      // awaiting approval - could list every active session and delete them,
      // force-logging out the whole company.
      //
      // `get` and `list` are split deliberately. A rule on `resource.data` can
      // only be evaluated per document, so an ownership test cannot gate a
      // whole-collection query. The app's own reads match this split: the
      // session manager watches a SINGLE session document (a `get`), while the
      // active-workstation list, the stale-session sweep and session revocation
      // all live on the user-admin screen.
      allow get: if isAuthenticated() &&
                    (request.auth.uid == resource.data.get('userId', '') || isAdmin());
      allow list: if isAdmin();

      allow create: if isAuthenticated() &&
                       request.resource.data.get('userId', '') == request.auth.uid;
      allow update, delete: if isAuthenticated() &&
                       (request.auth.uid == resource.data.get('userId', '') || isAdmin());
    }

    match /usernames/{username} {
      // Login resolves username -> email before sign-in, so an unauthenticated
      // read of a SINGLE known document is required. Listing is not.
      allow get: if true;
      allow list: if isAuthenticated();
      // The new document must point back at its creator; without this any
      // signed-in user could claim arbitrary username documents and block real
      // staff from registering them. An admin provisioning an account from the
      // user-admin screen is writing on someone else's behalf, so it is allowed
      // too - and `update` is stated explicitly, because saveUser re-writes this
      // document with merge whenever a user is edited.
      allow create, update: if isAdmin() ||
                       (isAuthenticated() &&
                        request.resource.data.get('uid', '') == request.auth.uid);
      allow delete: if isAdmin();
    }
    
    match /logs/{logId} {
      // Was `if true`: any anonymous caller could create unlimited documents.
      allow create: if isAuthenticated();
      allow read, delete: if isAdmin();
    }

    // --- Unified Application Data Rules ---

    match /{collectionName}/{docId} {
      allow read, write: if isApproved();
      
      match /{allPaths=**} {
        allow read, write: if isApproved();
      }
    }
  }
}
