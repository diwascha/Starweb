{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "firebase/firestore": ["./src/lib/supabase-compat/firestore.ts"],
      "firebase/auth": ["./src/lib/supabase-compat/auth.ts"],
      "firebase/app": ["./src/lib/supabase-compat/app.ts"],
      "firebase/storage": ["./src/lib/supabase-compat/storage.ts"],
      "firebase/database": ["./src/lib/supabase-compat/database.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
